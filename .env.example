ANKORA_ADMIN_PASSWORD=cambiar-por-una-contraseña-propia
ANKORA_SESSION_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Code the team enters once per device to see the internal catalogue (notes and recipes). Required.
ANKORA_SELLER_CODE=cambiar-por-un-codigo-para-el-equipo
# Hosts of the central admin panel, comma-separated. Optional, default betayomega.vercel.app,panel.localhost.
PANEL_HOSTS=betayomega.vercel.app,panel.localhost
# Site served to hosts that are not in lib/sites.ts (localhost, LAN IP). Optional, default nekurel.
DEFAULT_SITE=nekurel
# Supabase (required). The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...